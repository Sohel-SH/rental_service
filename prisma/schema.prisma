generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model deal {
  id                       String   @id
  propertyId               String
  buyerId                  String
  sellerId                 String
  dealType                 String   @default("RENTAL_LEASE")
  finalPrice               Int
  tokenPaid                Int      @default(0)
  brokerageFee             Int      @default(0)
  closingDate              DateTime @default(now())
  status                   String   @default("COMPLETED")
  notes                    String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime
  user_deal_buyerIdTouser  user     @relation("deal_buyerIdTouser", fields: [buyerId], references: [id], onDelete: Cascade, map: "Deal_buyerId_fkey")
  property                 property @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "Deal_propertyId_fkey")
  user_deal_sellerIdTouser user     @relation("deal_sellerIdTouser", fields: [sellerId], references: [id], onDelete: Cascade, map: "Deal_sellerId_fkey")

  @@index([buyerId], map: "Deal_buyerId_fkey")
  @@index([propertyId], map: "Deal_propertyId_fkey")
  @@index([sellerId], map: "Deal_sellerId_fkey")
}

model document {
  id           String   @id
  userId       String
  documentType String
  fileUrl      String
  fileName     String   @default("")
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Document_userId_fkey")

  @@index([userId], map: "Document_userId_fkey")
}

model lead {
  id            String   @id
  propertyId    String
  tenantId      String?
  name          String
  email         String
  phone         String
  message       String   @db.Text
  status        String   @default("new")
  assignedAgent String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  property      property @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "Lead_propertyId_fkey")
  user          user?    @relation(fields: [tenantId], references: [id], map: "Lead_tenantId_fkey")

  @@index([propertyId], map: "Lead_propertyId_fkey")
  @@index([tenantId], map: "Lead_tenantId_fkey")
}

model lease {
  id                        String    @id
  propertyId                String
  tenantId                  String
  ownerId                   String
  startDate                 DateTime
  endDate                   DateTime
  durationMonths            Int       @default(11)
  monthlyRent               Int
  securityDeposit           Int
  status                    String    @default("ACTIVE")
  noticeDate                DateTime?
  vacatingDate              DateTime?
  noticeReason              String?   @db.Text
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime
  user_lease_ownerIdTouser  user      @relation("lease_ownerIdTouser", fields: [ownerId], references: [id], onDelete: Cascade, map: "Lease_ownerId_fkey")
  property                  property  @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "Lease_propertyId_fkey")
  user_lease_tenantIdTouser user      @relation("lease_tenantIdTouser", fields: [tenantId], references: [id], onDelete: Cascade, map: "Lease_tenantId_fkey")
  payment                   payment[]

  @@index([ownerId], map: "Lease_ownerId_fkey")
  @@index([propertyId], map: "Lease_propertyId_fkey")
  @@index([tenantId], map: "Lease_tenantId_fkey")
}

model payment {
  id            String    @id
  leaseId       String?
  propertyId    String
  userId        String
  title         String    @default("Rent Payment")
  amount        Int
  type          String    @default("RENT")
  status        String    @default("PENDING")
  paymentMethod String    @default("UPI")
  transactionId String?
  dueDate       DateTime?
  paidAt        DateTime?
  receiptNumber String?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  lease         lease?    @relation(fields: [leaseId], references: [id], map: "Payment_leaseId_fkey")
  property      property  @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "Payment_propertyId_fkey")
  user          user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Payment_userId_fkey")

  @@index([leaseId], map: "Payment_leaseId_fkey")
  @@index([propertyId], map: "Payment_propertyId_fkey")
  @@index([userId], map: "Payment_userId_fkey")
}

model property {
  id               String    @id
  title            String
  description      String    @db.Text
  price            Int
  location         String
  propertyType     String
  bhk              Int
  images           String    @db.Text
  ownerId          String
  isAvailable      Boolean   @default(true)
  listingOption    String    @default("rent")
  latitude         Float     @default(18.5913)
  longitude        Float     @default(73.7389)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  availability     String    @default("Immediate")
  availableFor     String    @default("Family")
  carpetArea       Int       @default(800)
  furnishingType   String    @default("Semi Furnished")
  livingExperience String    @default("Managed by Owner")
  lookingFor       String    @default("House")
  parking          String    @default("Two Wheeler")
  occupancyStatus  String    @default("available")
  vacantFromDate   DateTime?
  deal             deal[]
  lead             lead[]
  lease            lease[]
  payment          payment[]
  user             user      @relation(fields: [ownerId], references: [id], onDelete: Cascade, map: "Property_ownerId_fkey")
  ticket           ticket[]

  @@index([ownerId], map: "Property_ownerId_fkey")
}

model ticket {
  id          String   @id
  tenantId    String
  propertyId  String
  title       String
  description String   @db.Text
  status      String   @default("open")
  priority    String   @default("medium")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  property    property @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "Ticket_propertyId_fkey")
  user        user     @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Ticket_tenantId_fkey")

  @@index([propertyId], map: "Ticket_propertyId_fkey")
  @@index([tenantId], map: "Ticket_tenantId_fkey")
}

model user {
  id                         String     @id
  name                       String
  email                      String     @unique(map: "User_email_key")
  password                   String
  phone                      String?
  role                       String     @default("tenant")
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime
  deal_deal_buyerIdTouser    deal[]     @relation("deal_buyerIdTouser")
  deal_deal_sellerIdTouser   deal[]     @relation("deal_sellerIdTouser")
  document                   document[]
  lead                       lead[]
  lease_lease_ownerIdTouser  lease[]    @relation("lease_ownerIdTouser")
  lease_lease_tenantIdTouser lease[]    @relation("lease_tenantIdTouser")
  payment                    payment[]
  property                   property[]
  ticket                     ticket[]
}
